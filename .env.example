# Скопируйте файл в .env и заполните локально. Реальные значения не коммитьте.
BOT_TOKEN=
BOT_USERNAME=autotgproxysuperbot
TG_WEBHOOK_SECRET=
DATABASE_URL=
SECRET_KEY=
BASE_URL=
ADMIN_PASSWORD=
ADMIN_PATH=
PROBE_REGION=us-oregon
PORT=5000

# Необязательные настройки источников прокси
FETCH_PROXY=
PROXY_CHANNELS=
PROXY_SOURCE_URLS=

# Сбор, каталог и локальная проверка из Орегона
PROXY_UPDATE_INTERVAL=180
PROXY_CACHE_SIZE=300
PROXY_RECHECK_INTERVAL=180
PROXY_PROBE_BATCH=4
# По умолчанию используется tdjson из requirements.txt
TDJSON_LIBRARY=

# Частные узлы: отдельный токен от 32 символов у каждого.
# Пример и команды запуска: docs/proxy-selection-logic.md
PROBE_AGENTS_JSON=[]

# Только для проверенной цепочки reverse proxy. При 0 X-Forwarded-For игнорируется.
TRUSTED_PROXY_HOPS=0

# Публичные документы: заполните фактические сведения перед утверждением.
# Пока обязательные сведения отсутствуют, страницы явно отмечены как проекты.
LEGAL_OPERATOR_NAME=
LEGAL_POSTAL_ADDRESS=
LEGAL_PRIVACY_EMAIL=autotgproxy@gmail.com
# ИНН и ОГРН/ОГРНИП — если применимы к владельцу
LEGAL_INN=
LEGAL_REGISTRATION_NUMBER=
LEGAL_DATABASE_COUNTRY=
LEGAL_PROCESSORS=
LEGAL_LOG_RETENTION=
LEGAL_BACKUP_RETENTION=

# На отдельной машине агента (не на основном сервере):
# PROBE_SERVER_URL=https://your-site.example
# PROBE_AGENT_TOKEN=
# PROBE_NETWORK_EPOCH=home-route-1
# PROBE_MAX_CHECKS_PER_HOUR=120
